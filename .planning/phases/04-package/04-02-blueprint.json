  "runtime_profiles": [
    {
      "id": "openclaw",
      "role": "primary",
      "status": "experimental",
      "purpose": "openclaw runtime profile for support-triage MVP production path.",
      "owned_surfaces": [
        "generated workspace",
        "agent config",
        "runbook",
        "birth report"
      ],
      "evidence_boundaries": [
        "bounded discovery pack",
        "managed run-state",
        "birth-report summary",
        "no full conversation logs by default"
      ],
      "source_refs": [
        "examples/support-triage.discovery.json",
        "docs/AGENT_BIRTH_GATE.md"
      ],
      "transfer_rules": [
        "Keep provider, model, runtime, channel, and target evidence separate."
      ],
      "supported_assets": [
        "generated scaffold",
        "handoff package",
        "declared run evidence"
      ],
      "unsupported_surfaces": [
        "production deployment",
        "domain certification",
        "runtime parity without live-success eval evidence"
      ],
      "install_or_onramp": "Use agentmo handoff --target openclaw and run the birth gate before promotion.",
      "verification_commands": [
        "agentmo validate \"<blueprint.json>\" --digest \"blueprint=$(node -e 'const fs=require(\"node:fs\");const crypto=require(\"node:crypto\");fs.writeSync(1,\"sha256:\"+crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[1])).digest(\"hex\"));' \"<blueprint.json>\")\"",
        "agentmo scaffold \"<blueprint.json>\" --digest \"blueprint=$(node -e 'const fs=require(\"node:fs\");const crypto=require(\"node:crypto\");fs.writeSync(1,\"sha256:\"+crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[1])).digest(\"hex\"));' \"<blueprint.json>\")\" --target \"openclaw\" --out \"<runtime-output>\"",
        "agentmo run-plan \"<blueprint.json>\" --digest \"blueprint=$(node -e 'const fs=require(\"node:fs\");const crypto=require(\"node:crypto\");fs.writeSync(1,\"sha256:\"+crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[1])).digest(\"hex\"));' \"<blueprint.json>\")\" --target \"openclaw\" --workspace \"<runtime-workspace>\" --message \"<smoke-message>\" --json > \"<runtime-plan.json>\"",
        "agentmo run \"<runtime-plan.json>\" --digest \"runtime-plan=$(node -e 'const fs=require(\"node:fs\");const crypto=require(\"node:crypto\");fs.writeSync(1,\"sha256:\"+crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[1])).digest(\"hex\"));' \"<runtime-plan.json>\")\" --workspace \"<runtime-workspace>\" --message \"<smoke-message>\" --out \"<run-output>\" --json",
        "agentmo run-eval \"<run-state.json>\" --digest \"run-state=$(node -e 'const fs=require(\"node:fs\");const crypto=require(\"node:crypto\");fs.writeSync(1,\"sha256:\"+crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[1])).digest(\"hex\"));' \"<run-state.json>\")\" --expect-status \"declared\" --json > \"<run-eval.json>\"",
        "agentmo birth-report \"<blueprint.json>\" --digest \"blueprint=$(node -e 'const fs=require(\"node:fs\");const crypto=require(\"node:crypto\");fs.writeSync(1,\"sha256:\"+crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[1])).digest(\"hex\"));' \"<blueprint.json>\")\" --digest \"build-state=$(node -e 'const fs=require(\"node:fs\");const crypto=require(\"node:crypto\");fs.writeSync(1,\"sha256:\"+crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[1])).digest(\"hex\"));' \"<agentmo-build-state.json>\")\" --digest \"run-state=$(node -e 'const fs=require(\"node:fs\");const crypto=require(\"node:crypto\");fs.writeSync(1,\"sha256:\"+crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[1])).digest(\"hex\"));' \"<run-state.json>\")\" --digest \"run-eval=$(node -e 'const fs=require(\"node:fs\");const crypto=require(\"node:crypto\");fs.writeSync(1,\"sha256:\"+crypto.createHash(\"sha256\").update(fs.readFileSync(process.argv[1])).digest(\"hex\"));' \"<run-eval.json>\")\" --build-state \"<agentmo-build-state.json>\" --run-state \"<run-state.json>\" --run-eval \"<run-eval.json>\" --expect-status \"declared\" --json > \"<birth-report.json>\"",
        "npm run check"
      ],
      "risk_notes": [
        "Draft runtime profile is not certified until live-success birth evidence exists."
      ],
      "owner": "AgentMo MVP operator",
      "last_verified_at": "2026-07-06"
    }
