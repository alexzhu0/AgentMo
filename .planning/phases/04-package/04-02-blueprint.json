  "domain_genome": {
    "domain": "customer_support_ticket_triage",
    "purpose": "Support operators need a bounded agent that classifies incoming support tickets, identifies missing customer or policy evidence, and drafts concise replies without making unsupported promises.",
    "task_classes": [
      "classify-ticket-category-and-priority",
      "draft-evidence-backed-customer-reply",
      "escalate-missing-policy-or-missing-customer-fact-cases"
    ],
    "knowledge_sources": [
      "quality-rubric",
      "support-policy-handbook",
      "ticket-taxonomy"
    ],
    "hard_failures": [
      "promise-refund-without-policy-evidence",
      "invent-customer-account-facts",
      "expose-raw-ticket-transcript-or-credentials",
      "skip-escalation-for-legal-or-account-access-risk"
    ]
  },
  "architecture": {
    "main_agent": "support-triage-main",
    "specialists": [
      {
        "id": "support-triage-classify-ticket-category-and-pri",
        "purpose": "classify ticket category and priority"
      },
      {
        "id": "support-triage-draft-evidence-backed-customer-r",
        "purpose": "draft evidence-backed customer reply"
      },
      {
        "id": "support-triage-escalate-missing-policy-or-missi",
        "purpose": "escalate missing-policy or missing-customer-fact cases"
      }
    ],
    "routing_modes": [
      "classify-ticket-category-and-priority",
      "draft-evidence-backed-customer-reply",
      "escalate-missing-policy-or-missing-customer-fact-cases"
    ]
  },
  "tools": [
    {
      "name": "support-triage_classify_ticket_category_and_priority",
      "purpose": "Support the workflow task: classify ticket category and priority",
      "allowed_when": [
        "classify ticket category and priority"
      ],
      "forbidden_when": [
        "promise refund without policy evidence",
        "invent customer account facts",
        "expose raw ticket transcript or credentials",
        "skip escalation for legal or account-access risk"
      ],
      "evidence_policy": "Use bounded discovery-db fact refs and disclose missing or unverified source coverage."
    },
    {
      "name": "support-triage_draft_evidence_backed_customer_reply",
      "purpose": "Support the workflow task: draft evidence-backed customer reply",
      "allowed_when": [
        "draft evidence-backed customer reply"
      ],
      "forbidden_when": [
        "promise refund without policy evidence",
        "invent customer account facts",
        "expose raw ticket transcript or credentials",
        "skip escalation for legal or account-access risk"
      ],
      "evidence_policy": "Use bounded discovery-db fact refs and disclose missing or unverified source coverage."
    },
    {
      "name": "support-triage_escalate_missing_policy_or_missing_customer_fact_cases",
      "purpose": "Support the workflow task: escalate missing-policy or missing-customer-fact cases",
      "allowed_when": [
        "escalate missing-policy or missing-customer-fact cases"
      ],
      "forbidden_when": [
        "promise refund without policy evidence",
        "invent customer account facts",
        "expose raw ticket transcript or credentials",
        "skip escalation for legal or account-access risk"
      ],
      "evidence_policy": "Use bounded discovery-db fact refs and disclose missing or unverified source coverage."
    }
  ],
